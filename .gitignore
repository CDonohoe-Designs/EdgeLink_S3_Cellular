# KiCad recovery files and per-user state; retain editable sources and models.
*-backups/
_restore_backup_*/
.history/
*.bak
*.bck
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_sch_old
*.kicad_pcb_old
*.kicad_prl
*.lck
*.kicad_pro.lock
*.kicad_sch.lock
*.kicad_pcb.lock
~$*
~*.kicad_*
_autosave-*
fp-info-cache
*.kicad_pcb.cache
*.kicad_sch.cache

# Operating-system, editor, Python and build caches.
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.cache/
.venv/
venv/
node_modules/
*.tmp
*.temp
*.swp
*.swo
*.log

# Local credentials and machine-specific agent settings.
.env
.env.*
!.env.example
!.env.template
credentials.json
*_token_cache.json
*.pem
*.key
.codex/
.agents/

# Local study, historical and working material; exclusion does not delete it.
/reference_designs/
/hardware/kicad/archive/
/hardware/kicad/libraries/
/hardware/kicad/README.md
/hardware/kicad/EdgeLink_S3_Cellular_RevA/libraries/README.md
/manufacturing/legacy/
/manufacturing/REV_A/bom/*.xlsx
/manufacturing/REV_A/bom/EdgeLink_S3_Cellular_RevA_BOM_Final.csv
/manufacturing/REV_A/bom/EdgeLink_S3_Cellular_RevA_BOM_JLCPCB_READY.csv
/docs/archive/
/docs/datasheets/
/docs/reports/
/docs/EdgeLink_S3_Design_Specification.md
/docs/schematics/EdgeLink_S3_Schematic_RevA.pdf
/docs/schematics/EdgeLink_S3_Cellular.pdf
/docs/images/*
!/docs/images/architecture-reva.svg
/EdgeLink_S3_Cellular_RevA_*Review*.docx
/firmware/README.md
/LICENSE

# Keep deliberate Gerber/drill/CSV/ZIP/PDF releases and CAD library/model assets.
# Do not add global *.zip, *.csv, *.step, *.wrl, *.gbr or *.drl exclusions.
